{{ define "title" }}Horizon{{ end }}

{{ define "head" }}
    <link rel="stylesheet" href="{{ .StylesURL }}">
{{ end }}

{{ define "content" }}
    {{ if .NeedsTimezoneSetup }}
    <section class="horizon-view horizon-setup" aria-labelledby="horizon-title" data-horizon-setup tabindex="-1">
        <header class="horizon-heading">
            <div>
                <p class="horizon-eyebrow">Your time, in motion</p>
                <h1 id="horizon-title">Set up Horizon</h1>
                <p class="horizon-window">Create your first calendar to use your local timezone and open the 90-day Horizon.</p>
            </div>
        </header>
        <form class="horizon-resource-form horizon-setup-form" data-horizon-setup-form data-resource-url="{{ .CalendarCreateURL }}">
            <label>Calendar name <input name="name" value="RSVP Events" required></label>
            <label>Symbol <input name="symbol" value="R" required></label>
            <input name="color_token" type="hidden" value="rsvp-events">
            <input name="timezone" type="hidden" data-client-timezone>
            <button type="submit">Start Horizon</button>
        </form>
        <p class="visually-hidden" aria-live="polite" data-horizon-setup-status></p>
    </section>
    {{ else }}
    <section
        class="horizon-view"
        aria-labelledby="horizon-title"
        data-horizon-view
        data-window-days="{{ .WindowDays }}"
        tabindex="-1"
    >
        <header class="horizon-heading">
            <div>
                <p class="horizon-eyebrow">Your time, in motion</p>
                <h1 id="horizon-title">Horizon</h1>
                <p class="horizon-window">
                    <time datetime="{{ .Window.Start }}">{{ .Window.Start }}</time>
                    <span aria-hidden="true">→</span>
                    <time datetime="{{ .Window.End }}">{{ .Window.End }}</time>
                    <span>{{ .Window.Timezone }}</span>
                </p>
            </div>
            <div class="horizon-view-controls" aria-label="Horizon view controls">
                <button type="button" data-pan="backward" aria-label="Pan backward">←</button>
                <button type="button" data-scale="out" aria-label="Scale out">−</button>
                <button type="button" data-scale="in" aria-label="Scale in">+</button>
                <button type="button" data-pan="forward" aria-label="Pan forward">→</button>
            </div>
        </header>

        <div class="horizon-calendar-controls" role="group" aria-label="Calendar visibility">
            {{ range $calendarIndex, $calendar := .Calendars }}
                <label
                    class="horizon-calendar-toggle"
                    data-calendar-control="{{ $calendar.ID }}"
                    data-color-token="{{ $calendar.ColorToken }}"
                >
                    <input
                        type="checkbox"
                        data-calendar-toggle="{{ $calendar.ID }}"
                        data-visibility-url="{{ $calendar.VisibilityURL }}"
                        data-shortcut="{{ $calendarIndex }}"
                        {{ if $calendar.Visible }}checked{{ end }}
                    >
                    <span class="horizon-calendar-symbol" aria-hidden="true">{{ $calendar.Symbol }}</span>
                    <span>{{ $calendar.Name }}</span>
                    {{ if lt $calendarIndex 9 }}<kbd>{{ addOne $calendarIndex }}</kbd>{{ end }}
                </label>
            {{ else }}
                <p>No calendars are available.</p>
            {{ end }}
        </div>

        <details class="horizon-management" data-quick-add>
            <summary>Quick add</summary>
            <form class="horizon-resource-form" data-resource-form data-method="POST" data-resource-url="{{ .IngestionDraftCreateURL }}">
                <h2>Natural-language draft</h2>
                <input name="source" type="hidden" value="natural_language">
                <label>Request <textarea name="input_text" required></textarea></label>
                <label>Calendar <select name="calendar_id" required>{{ range .Calendars }}<option value="{{ .ID }}">{{ .Symbol }} {{ .Name }}</option>{{ end }}</select></label>
                <input name="reference_time" type="hidden" data-reference-time>
                <input name="timezone" type="hidden" data-client-timezone>
                <button type="submit">Parse into draft</button>
            </form>
            <form class="horizon-resource-form" data-resource-form data-ingestion-draft-form data-quick-add-form data-method="POST" data-resource-url="{{ .IngestionDraftCreateURL }}">
                <input name="source" type="hidden" value="quick">
                <label>Mode <select name="mode" data-quick-mode><option value="dated_event">Dated event</option><option value="open_lane">Open lane</option></select></label>
                <label>Calendar <select name="calendar_id" required>{{ range .Calendars }}<option value="{{ .ID }}">{{ .Symbol }} {{ .Name }}</option>{{ end }}</select></label>
                <label>Title <input name="title" required></label>
                <label data-event-field>Anchor event <select name="anchor_event_id"><option value="">Independent event</option>{{ range .AnchorEvents }}<option value="{{ .ID }}">{{ .Title }}</option>{{ end }}</select></label>
                <label data-event-field>Start <input name="starts_at" type="datetime-local" required></label>
                <label data-event-field>End <input name="ends_at" type="datetime-local" required></label>
                <label data-open-field>Review interval seconds <input name="review_interval_seconds" type="number" min="1"></label>
                <label data-open-field>Next probe <input name="next_probe_at" type="datetime-local"></label>
                <label data-open-field>Escalation interval seconds <input name="escalation_interval_seconds" type="number" min="1"></label>
                <input name="reference_time" type="hidden" data-reference-time>
                <input name="timezone" type="hidden" data-client-timezone>
                <button type="submit">Create ingestion draft</button>
            </form>
            {{ range .IngestionDraftViews }}
            {{ $draft := . }}
            <section class="horizon-resource-card" data-ingestion-draft="{{ .ID }}">
                <h2>Confirm proposal: {{ .Title }}</h2>
                {{ if eq .Source "natural_language" }}<p>Parser-inferred proposal.</p>{{ end }}
                {{ if .MissingFields }}<p>Missing required values: {{ range $index, $field := .MissingFields }}{{ if $index }}, {{ end }}{{ $field }}{{ end }}.</p>{{ end }}
                <p>Calendar: {{ .CalendarName }}. Lane: {{ .ProposedLane }}. Mode: {{ .Mode }}.</p>
                {{ if eq .Mode "dated_event" }}
                <p>Marker: {{ .StartsAt }} to {{ .EndsAt }}. Attention: none.</p>
                {{ else }}
                <p>Marker: none. Attention: {{ if .ReviewIntervalSeconds }}review every {{ .ReviewIntervalSeconds }} seconds, next probe {{ .NextProbeAt }}{{ else }}none{{ end }}.</p>
                {{ end }}
                {{ if .DerivedRuleSummaries }}<p>Relative marker rules: {{ range $index, $rule := .DerivedRuleSummaries }}{{ if $index }}; {{ end }}{{ $rule }}{{ end }}.</p>{{ end }}
                <form data-resource-form data-ingestion-draft-form data-method="PATCH" data-resource-url="{{ .ManagementURL }}">
                    <input name="mode" type="hidden" value="{{ .Mode }}">
                    <label>Calendar <select name="calendar_id">{{ range $.Calendars }}<option value="{{ .ID }}" {{ if eq .ID $draft.CalendarID }}selected{{ end }}>{{ .Name }}</option>{{ end }}</select></label>
                    <label>Title <input name="title" value="{{ .Title }}" required></label>
                    {{ if eq .Mode "dated_event" }}
                    <label>Anchor event <select name="anchor_event_id"><option value="">Independent event</option>{{ range $.AnchorEvents }}<option value="{{ .ID }}" {{ if eq .ID $draft.AnchorEventID }}selected{{ end }}>{{ .Title }}</option>{{ end }}</select></label>
                    <label>Start <input name="starts_at" type="datetime-local" value="{{ .StartsAt }}" required></label>
                    <label>End <input name="ends_at" type="datetime-local" value="{{ .EndsAt }}" required></label>
                    {{ else }}
                    <label>Review interval seconds <input name="review_interval_seconds" type="number" min="1" value="{{ .ReviewIntervalSeconds }}"></label>
                    <label>Next probe <input name="next_probe_at" type="datetime-local" value="{{ .NextProbeAt }}"></label>
                    <label>Escalation interval seconds <input name="escalation_interval_seconds" type="number" min="1" value="{{ .EscalationIntervalSeconds }}"></label>
                    {{ end }}
                    <input name="reference_time" type="hidden" value="{{ .ReferenceTime }}">
                    <label>Timezone <input name="timezone" value="{{ .Timezone }}" required></label>
                    <button type="submit">Save proposal</button>
                </form>
                {{ if eq .Status "ready" }}<button type="button" data-draft-confirm data-resource-url="{{ .ConfirmationURL }}">Confirm draft</button>{{ end }}
                <button type="button" data-resource-action="DELETE" data-resource-url="{{ .ManagementURL }}">Cancel draft</button>
            </section>
            {{ end }}
        </details>

        <p class="horizon-shortcuts">
            Keyboard: H/L pan, −/+ scale, J/K select markers, and 1–9 toggle calendars.
        </p>
        <p class="visually-hidden" aria-live="polite" data-horizon-status></p>

        <div class="horizon-viewport" data-horizon-viewport tabindex="0" aria-label="Scrollable horizon timeline">
            <div class="horizon-board" data-horizon-board>
                <div class="horizon-scale-row" aria-hidden="true">
                    <div class="horizon-lane-label horizon-scale-label">Lane</div>
                    <div class="horizon-scale-track">
                        {{ range .TimeScaleTicks }}
                            <time class="horizon-scale-tick" datetime="{{ .DateTime }}" style="--tick-position: {{ .Position }}">{{ .Label }}</time>
                        {{ end }}
                        {{ if .TodayPosition }}
                            <span class="horizon-today-label" style="--today-position: {{ . }}">Today</span>
                        {{ end }}
                    </div>
                </div>

                {{ range $calendar := .Calendars }}
                    <section
                        class="horizon-calendar"
                        aria-label="{{ $calendar.Name }} calendar"
                        data-calendar-id="{{ $calendar.ID }}"
                        data-color-token="{{ $calendar.ColorToken }}"
                        {{ if not $calendar.Visible }}hidden{{ end }}
                    >
                        {{ range $calendar.Lanes }}
                            <div class="horizon-lane-row" data-lane-id="{{ .ID }}" data-lane-open="{{ .IsOpen }}">
                                <div class="horizon-lane-label">
                                    <span class="horizon-lane-symbol" aria-hidden="true">{{ $calendar.Symbol }}</span>
                                    <span>{{ .Title }}</span>
                                    <details class="horizon-lane-controls">
                                        <summary aria-label="Manage {{ .Title }}">•••</summary>
                                        <form data-resource-form data-method="PATCH" data-resource-url="{{ .ManagementURL }}">
                                            <label>Lane title <input name="title" value="{{ .Title }}" required></label>
                                            <button type="submit">Save lane</button>
                                        </form>
                                        <div class="horizon-resource-actions">
                                            {{ if .CanMoveUp }}<button type="button" data-resource-action="PATCH" data-resource-url="{{ .ManagementURL }}" data-display-order="{{ .PreviousOrder }}">Move lane up</button>{{ end }}
                                            {{ if .CanMoveDown }}<button type="button" data-resource-action="PATCH" data-resource-url="{{ .ManagementURL }}" data-display-order="{{ .NextOrder }}">Move lane down</button>{{ end }}
                                            {{ if .CanResolve }}<button type="button" data-resource-action="PATCH" data-resource-url="{{ .ManagementURL }}" data-resolve-lane>Resolve lane</button>{{ end }}
                                            <button type="button" data-resource-action="DELETE" data-resource-url="{{ .ManagementURL }}">Delete lane</button>
                                        </div>
                                        {{ if .CanResolve }}
                                            {{ if .Attention }}
                                                <p>Next attention: <time datetime="{{ .Attention.NextProbeAt }}">{{ .Attention.NextProbeInput }}</time></p>
                                                <form data-resource-form data-method="PATCH" data-resource-url="{{ .Attention.ManagementURL }}">
                                                    <label>Review interval seconds <input name="review_interval_seconds" type="number" min="1" value="{{ .Attention.ReviewIntervalSeconds }}" required></label>
                                                    <label>Next probe <input name="next_probe_at" type="datetime-local" value="{{ .Attention.NextProbeInput }}" required></label>
                                                    <label>Escalation interval seconds <input name="escalation_interval_seconds" type="number" min="1" data-nullable-empty {{ if .Attention.EscalationSeconds }}value="{{ .Attention.EscalationSeconds }}"{{ end }}></label>
                                                    <button type="submit">Save attention</button>
                                                </form>
                                                <button type="button" data-resource-action="DELETE" data-resource-url="{{ .Attention.ManagementURL }}">Delete attention</button>
                                            {{ else }}
                                                <form data-resource-form data-method="POST" data-resource-url="{{ $.AttentionCreateURL }}">
                                                    <input name="lane_id" type="hidden" value="{{ .ID }}">
                                                    <label>Review interval seconds <input name="review_interval_seconds" type="number" min="1" value="604800" required></label>
                                                    <label>Next probe <input name="next_probe_at" type="datetime-local" required></label>
                                                    <label>Escalation interval seconds <input name="escalation_interval_seconds" type="number" min="1"></label>
                                                    <button type="submit">Add attention</button>
                                                </form>
                                            {{ end }}
                                        {{ end }}
                                    </details>
                                </div>
                                <div class="horizon-lane-track">
                                    {{ if $.TodayPosition }}
                                        <span class="horizon-today-line" style="--today-position: {{ $.TodayPosition }}" aria-hidden="true"></span>
                                    {{ end }}
                                    <span
                                        class="horizon-lane-line {{ .EndStyle }}"
                                        style="--lane-start: {{ .StartPosition }}; --lane-end: {{ .EndPosition }}"
                                        aria-hidden="true"
                                    ></span>
                                    {{ range .Markers }}
                                        <button
                                            type="button"
                                            class="horizon-marker-target"
                                            style="--marker-position: {{ .Position }}"
                                            data-marker-id="{{ .ID }}"
                                            data-marker-type="{{ .Type }}"
                                            {{ if .ProbeState }}data-probe-state="{{ .ProbeState }}"{{ end }}
                                            aria-label="{{ .Title }}. {{ .Type }} marker."
                                            aria-describedby="marker-details-{{ .ID }}"
                                        >
                                            <span class="horizon-marker-dot" aria-hidden="true"></span>
                                        </button>
                                        <aside class="horizon-marker-details" id="marker-details-{{ .ID }}" data-marker-details="{{ .ID }}" hidden>
                                            <strong>{{ .Title }}</strong>
                                            <span>{{ .Type }}</span>
                                            {{ if .ProbeState }}<span>{{ .ProbeState }}</span>{{ end }}
                                            {{ if .IsEvent }}
                                                <a href="{{ .EventURL }}">Event controls</a>
                                                <a href="{{ .RSVPURL }}">RSVP controls</a>
                                                <form data-resource-form data-method="POST" data-resource-url="{{ $.DerivedCreateURL }}">
                                                    <input name="anchor_type" type="hidden" value="event">
                                                    <input name="anchor_id" type="hidden" value="{{ .ID }}">
                                                    <label>Offset base <select name="anchor_edge"><option value="start">Anchor start</option><option value="end">Anchor end</option></select></label>
                                                    <label>Offset seconds <input name="offset_seconds" type="number" value="-3600" required></label>
                                                    <button type="submit">Add derived marker</button>
                                                </form>
                                            {{ end }}
                                            {{ if .IsDerived }}
                                                <span>Anchor marker: {{ .AnchorMarkerID }}</span>
                                                <button type="button" data-resource-action="DELETE" data-resource-url="{{ .RuleURL }}">Delete derived marker</button>
                                            {{ end }}
                                            {{ if .CanComplete }}
                                                <button type="button" data-resource-action="PATCH" data-resource-url="{{ .ProbeURL }}" data-complete-probe>Complete probe</button>
                                            {{ end }}
                                        </aside>
                                    {{ end }}
                                </div>
                            </div>
                        {{ else }}
                            <p class="horizon-empty-calendar">No lanes intersect this window.</p>
                        {{ end }}
                    </section>
                {{ end }}
            </div>
        </div>
    </section>
    {{ end }}
{{ end }}

{{ define "scripts" }}
    <script src="{{ .ScriptURL }}" defer></script>
{{ end }}

{{ template "layout" . }}
